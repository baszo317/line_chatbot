# 複製成 .env 再填入。.env 有密碼和金鑰，不要上傳到 GitHub。

# ===== LINE（LINE Developers Console → 你的 Messaging API channel）=====
LINE_CHANNEL_SECRET=貼上 Basic settings 分頁的 Channel secret
LINE_CHANNEL_ACCESS_TOKEN=貼上 Messaging API 分頁最下方發行的 Channel access token

# ===== 資料庫 =====
DATABASE_URL=postgresql://postgres:你的密碼@localhost:5432/gaoming

# ===== Claude（Claude Console 建立的 API key；留空 = 只用關鍵字比對）=====
ANTHROPIC_API_KEY=
BOT_AI_MODEL=claude-haiku-5-5
BOT_AI_EFFORT=low

# ===== 補習班 =====
SCHOOL_NAME=高明補習班
FEE_UNIT=期
HUMAN_PAUSE_MINUTES=30

# ===== 後台 http://localhost:8000/admin（學生、家長、班級名單）=====
# 沒設定密碼 = 後台關閉。預設只能在跑 bot 的這台電腦開；要從別台電腦開，設定 BOT_ADMIN_ALLOW_REMOTE=true
BOT_ADMIN_PASSWORD=
BOT_ADMIN_ALLOW_REMOTE=false

# ===== 「補習班資料」資料夾（行事曆、公告、常見問題、榜單：丟檔案就更新）=====
# 留空 = 專案裡的「補習班資料」。也可以指到 Google 雲端硬碟的同步資料夾，例：G:\我的雲端硬碟\補習班資料
BOT_CONTENT_DIR=
BOT_CONTENT_POLL_SECONDS=30
# 只丟圖片時，用 AI 把圖片轉成文字草稿（要有 ANTHROPIC_API_KEY；草稿要人工核對後才會用）
BOT_AI_DRAFTS=true
BOT_VISION_MODEL=claude-sonnet-5-5

# bot 對外的 https 網址（傳圖片給家長用）。留空 = 從 LINE 打進來的請求自動判斷
BOT_PUBLIC_BASE_URL=
